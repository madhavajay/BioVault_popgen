# Python bytecode/cache files
__pycache__/
*.py[cod]
*$py.class

# Local runtime caches
.cache/
.docker/
!.docker/
!.docker/reference/
!.docker/reference/pca_loadings/
.docker/reference/pca_loadings/*
!.docker/reference/pca_loadings/loadings_variants.tsv
!.docker/reference/pca_loadings/loadings.npz
!.docker/reference/pca_loadings/gnomad.v3.1.pca_loadings.ht.tar.gz
!.docker/reference/aims/
.docker/reference/**/*.log
.docker/reference/**/*.crc
.docker/reference/pca_loadings/gnomad.v3.1.pca_loadings.ht/
.docker/reference/aims/*
!.docker/reference/aims/gnomad_af_per_locus.tsv
.docker/reference/hgp1k/
.docker/reference/hgdp_tgp_vcf/
.docker/conda_envs/
.claude/
.bvlr_cache/
**/.bvlr_cache/
.samples/
**/.samples/

# Nextflow runtime artefacts
.nextflow/
.nextflow.log*
work/
.biovault-runtime.config

# Flow runtime artefacts (regenerated by the BioVault/Nextflow runner;
# flow folders should only track flow.yaml / module.yaml / main.nf)
**/.bv_template.nf
flows/*/.bv_template.nf
flows/*/.biovault-runtime.config
flows/*/.nextflow/
flows/*/.nextflow.log*
flows/*/work/
flows/*/scripts/
flows/*/assets/
**/.DS_Store

# Pipeline outputs
/data/
results/
00_qc_test_data/
01_mock_data_generation/output/
01_mock_data_generation/facets/
01_mock_data_generation/scripts/out/
